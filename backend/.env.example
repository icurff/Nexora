
PORT=3000
DATABASE_URL=postgresql://nexora@localhost:5432/nexora
AUTH_ACCESS_SECRET=nexora
AUTH_REFRESH_SECRET=nexora
COOKIE_SECURE=false
GMAIL_USER=
GMAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:5173
LOW_STOCK_THRESHOLD=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=catalog-images

# Required only for an explicitly requested demo seed.
DEMO_CUSTOMER_EMAIL=customer@example.test
DEMO_CUSTOMER_PASSWORD=replace_with_customer_password
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_admin_password

# Local LightGCN inference service; keep Nexora visitor IDs server-side.
AI_SERVICE_URL=http://127.0.0.1:8000

# Opt-in unauthenticated shared graph for local demos only; blocked in production.
NEXORA_SHARED_GRAPH=false

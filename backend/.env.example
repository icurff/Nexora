# Host development: loaded from backend/.env when npm runs in backend.
# Docker Compose injects configuration from the root .env instead.
PORT=3000

# Supabase PostgreSQL: copy the host/port from Dashboard > Connect.
# Prefer a direct connection; use the session pooler on IPv4-only networks.
# The app role must be provisioned with the required application-schema permissions.
# URL-encode the password. Omit sslmode/sslcert/sslkey/sslrootcert URL parameters.
DATABASE_URL=
# Optional Supabase server root certificate PEM, with literal \n between lines.
# Leave empty when the server certificate is trusted by Node's default CA store.
DATABASE_SSL_CA=

# Planned Catalog Storage integration; these values are not used by Auth.
SUPABASE_URL=
# Server-only secret key (or legacy service_role key); never use VITE_*.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=catalog-images

AUTH_ACCESS_SECRET=local-development-access-secret-change-this
AUTH_REFRESH_SECRET=local-development-refresh-secret-change-this
COOKIE_SECURE=false

# Required only for an explicitly requested demo seed.
DEMO_CUSTOMER_EMAIL=customer@example.test
DEMO_CUSTOMER_PASSWORD=replace_with_customer_password
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_admin_password

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  BigInt               @id @default(autoincrement())
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  fullName            String               @map("full_name") @db.VarChar(100)
  phone               String?              @db.VarChar(16)
  role                String               @default("CUSTOMER") @db.VarChar(16)
  status              String               @default("ACTIVE") @db.VarChar(16)
  lockedAt            DateTime?            @map("locked_at") @db.Timestamptz(6)
  lockReason          String?              @map("lock_reason") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  uploadedImageAssets ImageAsset[]
  inventoryAdjustments InventoryAdjustmentRequest[]
  cart                Cart?
  inventoryLedgerEntries InventoryLedger[]
  addresses           UserAddress[]

  @@map("users")
}

model UserAddress {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  recipientName  String   @map("recipient_name") @db.VarChar(100)
  recipientPhone String   @map("recipient_phone") @db.VarChar(16)
  provinceName   String   @map("province_name") @db.VarChar(150)
  wardName       String   @map("ward_name") @db.VarChar(150)
  addressLine    String   @map("address_line") @db.VarChar(300)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, createdAt, id], map: "user_addresses_user_created_idx")
  @@map("user_addresses")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  refreshVersion   Int       @default(0) @map("refresh_version")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, revokedAt], map: "auth_sessions_user_revoked_idx")
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement())
  userId    BigInt    @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "password_reset_tokens_user_created_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_idx")
  @@map("password_reset_tokens")
}

model Category {
  id              BigInt     @id @default(autoincrement())
  name            String     @db.VarChar(100)
  nameKey         String     @unique(map: "categories_name_key_key") @default("") @map("name_key")
  slug            String     @unique(map: "categories_slug_key") @db.VarChar(150)
  parentId        BigInt?    @map("parent_id")
  legacyOptionConfig Json     @default("{}") @map("option_config")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  children        Category[] @relation("CategoryTree")
  products        Product[]

  @@index([parentId, isActive], map: "categories_parent_active_idx")
  @@map("categories")
}

model Product {
  id          BigInt          @id @default(autoincrement())
  name        String          @db.VarChar(200)
  nameKey     String          @map("name_key") @db.VarChar(200)
  description String          @db.Text
  categoryId  BigInt          @map("category_id")
  status      String          @default("ACTIVE") @db.VarChar(16)
  optionConfig Json           @default("{}") @map("option_config")
    priceVnd    BigInt?         @map("price_vnd")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variants    ProductVariant[]
  images      ProductImage[]
    inventory   ProductInventory?
    cartItems   CartItem[]

  @@index([categoryId, status, createdAt(sort: Desc)], map: "products_category_status_created_idx")
  @@index([status, createdAt(sort: Desc)], map: "products_status_created_idx")
  @@map("products")
}

model ProductInventory {
  productId BigInt   @id @map("product_id")
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  version   BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("product_inventory")
}

model ProductVariant {
  id        BigInt          @id @default(autoincrement())
  productId BigInt          @map("product_id")
  sku       String          @unique @db.VarChar(40)
  options   Json            @default("{}")
  priceVnd  BigInt          @map("price_vnd")
  deletedAt DateTime?       @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  inventory Inventory?
  images    ProductImage[]
  cartItems CartItem[]

  @@index([productId, deletedAt], map: "product_variants_product_deleted_idx")
  @@map("product_variants")
}

model Inventory {
  variantId BigInt         @id @map("variant_id")
  onHand    Int            @default(0) @map("on_hand")
  reserved  Int            @default(0)
  version   BigInt         @default(0)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  entries   InventoryLedger[]

  @@map("inventory")
}

model InventoryLedger {
  id             BigInt    @id @default(autoincrement())
  variantId      BigInt    @map("variant_id")
  actorUserId    BigInt?   @map("actor_user_id")
  reason         String    @db.VarChar(500)
  quantityBefore Int       @map("quantity_before")
  quantityAfter  Int       @map("quantity_after")
  movementType   String?   @map("movement_type") @db.VarChar(24)
  reservedBefore Int?      @map("reserved_before")
  reservedAfter  Int?      @map("reserved_after")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  inventory      Inventory @relation(fields: [variantId], references: [variantId], onDelete: Restrict, onUpdate: NoAction)
  actor          User?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([variantId, createdAt(sort: Desc)], map: "inventory_ledger_variant_created_idx")
  @@map("inventory_ledger")
}

model InventoryAdjustmentRequest {
  id          BigInt   @id @default(autoincrement())
  actorUserId BigInt   @map("actor_user_id")
  key         String   @db.VarChar(100)
  payload     Json
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([actorUserId, key], map: "inventory_adjustment_requests_actor_key_key")
  @@map("inventory_adjustment_requests")
}

model ImageAsset {
  id              BigInt         @id @default(autoincrement())
  uploadedById    BigInt         @map("uploaded_by_id")
  bucket          String         @db.VarChar(100)
  objectPath      String         @map("object_path") @db.VarChar(500)
  contentType     String         @map("content_type") @db.VarChar(100)
  contentLength   Int            @map("content_length")
  publicUrl       String         @map("public_url") @db.VarChar(2048)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  uploadedBy      User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: NoAction)
  products        ProductImage[]

  @@unique([bucket, objectPath], map: "image_assets_bucket_path_key")
  @@map("image_assets")
}

model ProductImage {
  id           BigInt         @id @default(autoincrement())
  productId    BigInt         @map("product_id")
  variantId    BigInt?        @map("variant_id")
  imageAssetId BigInt         @map("image_asset_id")
  altText      String         @default("") @map("alt_text") @db.VarChar(200)
  sortOrder    Int            @default(0) @map("sort_order")
  isPrimary    Boolean        @default(false) @map("is_primary")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  product      Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  imageAsset   ImageAsset     @relation(fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([productId, imageAssetId], map: "product_images_product_asset_key")
  @@index([productId, sortOrder], map: "product_images_product_sort_idx")
  @@map("product_images")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt     @unique(map: "carts_user_id_key") @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        BigInt         @id @default(autoincrement())
  cartId    BigInt         @map("cart_id")
    variantId BigInt?        @map("variant_id")
    productId BigInt?        @map("product_id")
  quantity  Int
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: NoAction)
    product   Product?       @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([cartId, variantId], map: "cart_items_cart_variant_key")
    @@unique([cartId, productId], map: "cart_items_cart_product_key")
  @@index([variantId], map: "cart_items_variant_idx")
  @@map("cart_items")
}

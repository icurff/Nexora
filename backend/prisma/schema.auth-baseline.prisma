// Frozen data model for verifying and recording migration 0_auth on existing databases.
// This intentionally excludes later schema additions such as password_reset_tokens.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           BigInt        @id @default(autoincrement())
  email        String        @unique @db.VarChar(254)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  fullName     String        @map("full_name") @db.VarChar(100)
  phone        String?       @db.VarChar(16)
  role         String        @default("CUSTOMER") @db.VarChar(16)
  status       String        @default("ACTIVE") @db.VarChar(16)
  lockedAt     DateTime?     @map("locked_at") @db.Timestamptz(6)
  lockReason   String?       @map("lock_reason") @db.VarChar(500)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions     AuthSession[]

  @@map("users")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement())
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  refreshVersion   Int       @default(0) @map("refresh_version")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime  @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(50)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, revokedAt], map: "auth_sessions_user_revoked_idx")
  @@map("auth_sessions")
}

model LegacyAuthMigration {
  id        Int      @id
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("auth_schema_migrations")
}

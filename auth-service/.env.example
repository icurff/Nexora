# Host defaults for local development. Docker Compose injects its own DB values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=replace_with_local_auth_database_password

# Required only when running `npm run seed:demo`.
DEMO_CUSTOMER_EMAIL=customer@example.test
DEMO_CUSTOMER_PASSWORD=replace_with_customer_password
DEMO_ADMIN_EMAIL=admin@example.test
DEMO_ADMIN_PASSWORD=replace_with_admin_password

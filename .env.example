# Copy to root .env only when it does not already exist. Never commit .env.
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PORT=5432

# Required: choose a private local database password.
POSTGRES_PASSWORD=
# Required: PostgreSQL URL with the same user, password and database as above.
# Use host postgres and port 5432; percent-encode the password in the URL.
DATABASE_URL=

# Required: generate two separate random signing secrets privately.
AUTH_ACCESS_SECRET=
AUTH_REFRESH_SECRET=
COOKIE_SECURE=false
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000/api/v1

GMAIL_USER=
GMAIL_APP_PASSWORD=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=catalog-images
